# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Firebase config — contains the Android API key. Kept OUT of the repo; provided
# to EAS as a "file" env var GOOGLE_SERVICES_JSON and injected via app.config.js.
# A local copy stays on disk for local/dev-client builds.
google-services.json
GoogleService-Info.plist

# Claude Code per-user settings
.claude/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
# gradle build output for local Expo modules (e.g. modules/expo-pin-widget)
modules/**/build/

# local Temurin JDK 17 (toolchain for local Android builds)
/.jdk17

# local-only Gradle CN mirror init script
android/cn-mirrors.init.gradle

# Daily-verse staging (not committed — CDN files go to pd-text-corpus repo)
_incoming_verses/
_cdn_ready/

# Google Play service-account key for `eas submit` — secret, never commit
play-service-account.json

# Play policy audit skill scratch dir
.scratch/

# EAS local env-var materializations (eas env:pull) — same policy as google-services.json
.eas/

# Build artifacts downloaded for inspection (never commit; .easignore also skips them)
*.aab
*.apk
*.ipa
