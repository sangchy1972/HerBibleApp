# Mirror the local install behavior on clean CI / EAS Build machines.
# react is pinned 19.1.0 while some deps (react-dom ^19.1.0, etc.) resolve a
# newer 19.2.x and demand a matching react peer — npm v7+ would ERESOLVE on a
# fresh `npm install`. The committed package-lock.json already encodes the
# intended tree; this flag makes headless installs reproduce it without
# erroring on the peer mismatch. (Matches how deps were installed locally.)
legacy-peer-deps=true
