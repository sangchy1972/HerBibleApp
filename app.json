{
  "expo": {
    "name": "Her Bible",
    "slug": "HerBibleApp",
    "scheme": "herbible",
    "version": "1.4.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.holy.bible.kjv.audio.prayer",
      "buildNumber": "1",
      "icon": "./assets/icon-ios.png",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "Her Bible uses this to show ads that are more relevant to you. You can decline and still use every feature.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "fb",
          "fbapi",
          "fb-messenger",
          "instagram",
          "instagram-stories",
          "whatsapp"
        ],
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.holy.bible.kjv.audio.prayer",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F44F7B"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidPackageQueries.js",
      "./plugins/withLargeScreenCompat.js",
      "./plugins/withNativeDebugSymbols.js",
      "./plugins/withNotifeeMavenRepo.js",
      "./plugins/withKotlinGradlePlugin.js",
      "./plugins/withAdMobMediation.js",
      "./plugins/withMetaAdvertiserTracking.js",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/crashlytics",
      "expo-iap",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.553397384848-u1plipp9pj4ksv0f114spvdt63p292am"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Her Bible needs access to your photos so you can pick a profile picture. We only use the photo you select — nothing else is read or uploaded.",
          "cameraPermission": "Her Bible needs access to your camera so you can take a profile picture. We only use the photo you take — nothing else is captured."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Her Bible needs permission to save verse images to your photo library so you can keep or share them later.",
          "savePhotosPermission": "Her Bible needs permission to save verse images to your photo library so you can keep or share them later.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E63F69"
        }
      ],
      "expo-apple-authentication",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Lora_400Regular.ttf"
          ],
          "widgets": [
            {
              "name": "verseOfDay",
              "label": "Her Bible — Verse of the Day",
              "description": "Today's verse on your home screen.",
              "previewImage": "./assets/widget/preview.png",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 21600000
            },
            {
              "name": "verseOfDayWide",
              "label": "Her Bible — Verse of the Day (Wide)",
              "description": "Today's verse, wider layout.",
              "previewImage": "./assets/widget/preview.png",
              "minWidth": "320dp",
              "minHeight": "110dp",
              "targetCellWidth": 5,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 21600000
            },
            {
              "name": "verseOfDaySmall",
              "label": "Her Bible — Verse of the Day (Compact)",
              "description": "Today's verse, compact size.",
              "previewImage": "./assets/widget/preview.png",
              "minWidth": "120dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 21600000
            }
          ]
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
