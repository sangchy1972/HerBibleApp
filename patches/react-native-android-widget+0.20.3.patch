+    private Bitmap drawViewToBitmap(View rootView) throws Exception {
+        int width = Math.max(1, rootView.getMeasuredWidth());
+        int height = Math.max(1, rootView.getMeasuredHeight());
+        try {
+            return drawViewToBitmap(rootView, width, height, 1f);
+        } catch (OutOfMemoryError e) {
+            // Heap is momentarily full (app busy with images/ads). Retry at half
+            // resolution (quarter of the memory); the launcher upscales the result.
+            try {
+                return drawViewToBitmap(rootView, Math.max(1, width / 2), Math.max(1, height / 2), 0.5f);
+            } catch (OutOfMemoryError retryError) {
+                // Convert the Error into a checked Exception so the module-level
+                // catch skips this refresh instead of killing the process.
+                throw new Exception("Skipping widget draw: not enough memory", retryError);
+            }
+        }
+    }
+
+    private Bitmap drawViewToBitmap(View rootView, int width, int height, float scale) {
+        Bitmap bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888);
         Canvas bitmapHolder = new Canvas(bitmap);
+        if (scale != 1f) {
+            bitmapHolder.scale(scale, scale);
+        }
         rootView.draw(bitmapHolder);
         return bitmap;
     }
